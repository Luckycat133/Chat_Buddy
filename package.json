{
  "name": "chat-buddy",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.json --noEmit false --outDir dist/server --module NodeNext --moduleResolution NodeNext --target ES2022",
    "start:server": "node dist/server/server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:watch": "tsc -p tsconfig.json --noEmit --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:all": "vitest run --coverage --config vitest.full-coverage.config.js",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seeds/seed-demo.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "preview": "vite preview",
    "stress": "node scripts/stress-ui.mjs",
    "prompt:bench": "node scripts/prompt-regression-benchmark.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/websocket": "^11.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "dompurify": "3.4.15",
    "fastify": "^5.12.4",
    "framer-motion": "^13.2.0",
    "jose": "^6.2.12",
    "katex": "^0.18.7",
    "lucide-react": "^1.45.0",
    "mathjs": "^15.2.0",
    "mermaid": "12.0.0",
    "pino": "^10.3.1",
    "postgres": "3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "zod": "4.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.5.6",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "30.0.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.23.13",
    "typescript": "7.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "dompurify": "3.4.15",
    "nanoid": "3.3.18"
  }
}
