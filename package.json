{
  "name": "chat-buddy",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.json --noEmit false --outDir dist/server --module NodeNext --moduleResolution NodeNext --target ES2022",
    "start:server": "node dist/server/server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:watch": "tsc -p tsconfig.json --noEmit --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:all": "vitest run --coverage --config vitest.full-coverage.config.js",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seeds/seed-demo.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "preview": "vite preview",
    "stress": "node scripts/stress-ui.mjs",
    "prompt:bench": "node scripts/prompt-regression-benchmark.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/websocket": "^11.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "dompurify": "3.4.13",
    "fastify": "^5.12.4",
    "framer-motion": "^12.43.0",
    "jose": "^5.10.0",
    "katex": "^0.18.1",
    "lucide-react": "^1.27.0",
    "mathjs": "^15.2.0",
    "mermaid": "11.16.1",
    "pino": "^9.14.0",
    "postgres": "3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "zod": "3.23"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "29.0.0",
    "msw": "^2.15.0",
    "postcss": "^8.5.24",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.23.13",
    "typescript": "5.6",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.1.5",
    "vitest": "4.1.11"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "dompurify": "3.4.13",
    "nanoid": "3.3.18",
    "esbuild": "^0.28.1"
  }
}
