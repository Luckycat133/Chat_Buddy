# AI API Configuration - OpenAI Compatible Format
# You can use any OpenAI-compatible API provider (DeepSeek, Perplexity, OpenAI, etc.)

# API Base URL (without /chat/completions)
VITE_AI_API_URL=https://api.example.com

# API Key
# SECURITY NOTE: This key is embedded in the client bundle at build time.
# For production, use a backend proxy to keep keys server-side.
# Runtime keys entered in the UI are stored in sessionStorage only (cleared on tab close).
VITE_AI_API_KEY=your-api-key-here

# Model name (use provider-specific model names)
# Perplexity models: sonar (fast), sonar-pro (advanced)
# DeepSeek models: deepseek-chat
# OpenAI models: gpt-4o-mini, gpt-4o
VITE_AI_MODEL=your-model-name

# Tavily Web Search API Key (for AI-powered web search)
# Get your key at: https://tavily.com
# Used by: web_search tool, sonar_search fallback, real-time information retrieval
VITE_TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx
