# Server-side environment variables for the Chat Buddy cloud runtime.
# Copy to .env.server and fill in real values. NEVER commit .env.server.
# Per WEB_IMPLEMENTATION §4.2, secrets must never appear in client bundles.

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Database (PostgreSQL; PgBouncer transaction mode: set DATABASE_POOLED=true)
DATABASE_URL=postgres://chat_buddy:chat_buddy@localhost:5432/chat_buddy
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_SEC=30
DATABASE_POOLED=false

# Sessions (32+ random bytes; required)
SESSION_SIGNING_KEY=replace-me-with-32-bytes-of-random-data
SESSION_TTL_SEC=1209600

# Sign in with Apple (optional; required for TestFlight/Web production)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Magic link sender (Web fallback)
MAGIC_LINK_FROM=

# Hosted model gateway (server-side only; do NOT mirror to VITE_*)
MODEL_GATEWAY_URL=
MODEL_GATEWAY_KEY=

# Capability providers (server-side only)
SEARCH_PROVIDER_URL=
SEARCH_PROVIDER_KEY=
WEATHER_PROVIDER_URL=
WEATHER_PROVIDER_KEY=

# APNs (server-side only)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=

# Object storage (S3-compatible)
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Web origin (used for CORS allowlist and email links)
PUBLIC_WEB_URL=http://localhost:5173
ALLOWED_ORIGINS=
